rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Security Helper Functions ─────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && (request.auth.uid == userId);
    }

    function isValidFollow(data) {
      return (data.followerId == request.auth.uid)
          && (data.followingId != request.auth.uid)
          && data.keys().hasAll(["followerId", "followingId", "createdAt"]);
    }

    // ─── Users ────────────────────────────────────────────────────────────────
    // Path: /users/{userId}

    match /users/{userId} {
      allow read: if isAuthenticated();

      allow create: if isOwner(userId)
          && (request.resource.data.uid == userId)
          && (!request.resource.data.keys().hasAny(["reputationScore", "followersCount", "followingCount", "postsCount", "roles", "admin", "moderator", "verified"])
              || ( (request.resource.data.reputationScore == 100)
                  && (request.resource.data.followersCount == 0)
                  && (request.resource.data.followingCount == 0)
                  && (request.resource.data.postsCount == 0) ));

      // Profile updates restricted strictly to owner, prohibiting counter, reputation, role, or timestamp tampering.
      // All counter increments (followersCount, followingCount, postsCount) are managed via Cloud Functions / triggers.
      allow update: if isOwner(userId)
          && (request.resource.data.uid == userId)
          && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(["reputationScore", "followersCount", "followingCount", "postsCount", "joinedAt", "roles", "admin", "moderator", "verified"]);

      allow delete: if false;

      // Audit trail of username changes — viewable by owner, written only by Admin/Functions
      match /usernameHistory/{historyId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      // Per-user story view state cache — accessible only by doc owner
      match /storyViewState/{docId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ─── Usernames Index ─────────────────────────────────────────────────────
    // Path: /usernames/{usernameLower}
    // Public read for availability checks & profile URL resolution. Client writes disabled.

    match /usernames/{usernameLower} {
      allow read: if true;
      allow write: if false;
    }

    // ─── Posts ────────────────────────────────────────────────────────────────
    // Path: /posts/{postId}

    match /posts/{postId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated()
          && (request.resource.data.keys().hasAny(["userId", "authorId"]))
          && (!request.resource.data.keys().hasAny(["userId"]) || request.resource.data.userId == request.auth.uid)
          && (!request.resource.data.keys().hasAny(["authorId"]) || request.resource.data.authorId == request.auth.uid)
          && (request.resource.data.text is string)
          && (request.resource.data.text.size() <= 2000)
          && (!request.resource.data.keys().hasAny(["viewCount", "likes", "reposts", "commentsCount"])
              || ( (request.resource.data.viewCount == 0)
                  && (request.resource.data.likes == 0)
                  && (request.resource.data.reposts == 0)
                  && (request.resource.data.commentsCount == 0) ));

      // Post updates:
      // Restricted strictly to post owner editing content/fields.
      // All post interactions (likes, saves, reposts, poll votes, counter increments) are executed via Cloud Functions.
      allow update: if isAuthenticated()
          && ( (resource.data.userId == request.auth.uid) || (resource.data.authorId == request.auth.uid) )
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              "userId", "authorId", "createdAt", "viewCount", "likes", "likedBy", "savedBy", "reposts", "commentsCount", "poll"
          ]);

      allow delete: if isAuthenticated()
          && ( (resource.data.userId == request.auth.uid) || (resource.data.authorId == request.auth.uid) );
    }

    // ─── Comments ─────────────────────────────────────────────────────────────
    // Path: /posts/{postId}/comments/{commentId}

    match /posts/{postId}/comments/{commentId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated()
          && (request.resource.data.keys().hasAny(["userId", "authorId"]))
          && (!request.resource.data.keys().hasAny(["userId"]) || request.resource.data.userId == request.auth.uid)
          && (!request.resource.data.keys().hasAny(["authorId"]) || request.resource.data.authorId == request.auth.uid)
          && (request.resource.data.text is string)
          && (request.resource.data.text.size() <= 1000);

      allow update: if false;

      allow delete: if isAuthenticated()
          && ( (resource.data.userId == request.auth.uid) || (resource.data.authorId == request.auth.uid) );
    }

    // ─── Follows ─────────────────────────────────────────────────────────────
    // Path: /follows/{followId} ({followerId}_{followingId})

    match /follows/{followId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidFollow(request.resource.data);
      allow delete: if isAuthenticated() && (resource.data.followerId == request.auth.uid);
      allow update: if false;
    }

    // ─── Anonymous Whispers ───────────────────────────────────────────────────
    // Path: /whispers/{whisperId}
    // Anonymous messages must NEVER expose the sender's private identity to recipient.
    // Created exclusively via sendAnonymousWhisper Cloud Function to enforce server-side validation & rate limiting.

    match /whispers/{whisperId} {
      allow read: if isAuthenticated()
          && ( (resource.data.recipientId == request.auth.uid) || (resource.data.recipientUid == request.auth.uid) );

      allow create: if false;

      allow update: if isAuthenticated()
          && ( (resource.data.recipientId == request.auth.uid) || (resource.data.recipientUid == request.auth.uid) )
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["unread", "reactions"]);

      allow delete: if false;
    }

    // ─── Chats / Direct Messages ──────────────────────────────────────────────
    // Path: /chats/{chatId}

    match /chats/{chatId} {
      allow read: if isAuthenticated() && (request.auth.uid in resource.data.participants);
      // Created strictly via createChatThread Cloud Function to verify recipient identity in /users
      allow create: if false;
      allow update: if isAuthenticated()
          && (request.auth.uid in resource.data.participants)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["lastMessage", "updatedAt", "unreadCount"]);

      match /messages/{msgId} {
        allow read: if isAuthenticated()
            && (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants);
        allow create: if isAuthenticated()
            && (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants)
            && (request.resource.data.senderId == request.auth.uid)
            && (request.resource.data.text is string)
            && (request.resource.data.text.size() <= 1000);
        allow update: if false;
        allow delete: if isAuthenticated()
            && (resource.data.senderId == request.auth.uid);
      }
    }

    // ─── Communities ──────────────────────────────────────────────────────────
    // Path: /communities/{communityId}

    match /communities/{communityId} {
      allow read: if isAuthenticated() || (resource.data.visibility == 'public');
      // Created only via createCommunity Cloud Function to enforce slug uniqueness & initial owner assignment
      allow create: if false;
      allow update: if isAuthenticated()
          && (resource.data.ownerId == request.auth.uid)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["ownerId", "slug", "createdAt", "memberCount", "postCount"]);
      allow delete: if false;

      match /members/{memberId} {
        allow read: if isAuthenticated()
            && ( (get(/databases/$(database)/documents/communities/$(communityId)).data.visibility == 'public')
                || (request.auth.uid in get(/databases/$(database)/documents/communities/$(communityId)).data.members)
                || (memberId == request.auth.uid) );
        allow write: if false; // Managed via joinCommunity / leaveCommunity Cloud Functions
      }

      match /moderators/{modId} {
        allow read: if isAuthenticated()
            && ( (get(/databases/$(database)/documents/communities/$(communityId)).data.visibility == 'public')
                || (request.auth.uid in get(/databases/$(database)/documents/communities/$(communityId)).data.members)
                || (get(/databases/$(database)/documents/communities/$(communityId)).data.ownerId == request.auth.uid) );
        allow write: if false; // Managed via Cloud Functions
      }

      match /joinRequests/{reqId} {
        allow read: if isAuthenticated()
            && ( (reqId == request.auth.uid)
                || (get(/databases/$(database)/documents/communities/$(communityId)).data.ownerId == request.auth.uid) );
        allow write: if false; // Managed via joinCommunity Cloud Function
      }
    }

    // ─── Stories ───────────────────────────────────────────────────────────────
    // Path: /stories/{storyId}

    match /stories/{storyId} {
      allow read: if isAuthenticated()
          && (resource.data.expiresAt > request.time)
          && (resource.data.status == "active");

      // Created only via createStory Cloud Function to guarantee server-side timestamps & expiration
      allow create: if false;

      // Owner can only soft-delete (status = "deleted")
      allow update: if isAuthenticated()
          && (resource.data.authorId == request.auth.uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status"])
          && (request.resource.data.status == "deleted");

      allow delete: if false;

      match /viewers/{viewerId} {
        // Individual viewer records are write-disabled and read-disabled for clients.
        // View counts are tracked server-side atomically via recordStoryView Cloud Function.
        allow read, write: if false;
      }
    }

    // ─── Notifications ────────────────────────────────────────────────────────
    // Path: /notifications/{notificationId}

    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (resource.data.recipientId == request.auth.uid);
      // Created only by Cloud Functions / Admin SDK
      allow create: if false;
      allow update: if isAuthenticated()
          && (resource.data.recipientId == request.auth.uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["unread"]);
      allow delete: if isAuthenticated() && (resource.data.recipientId == request.auth.uid);
    }

    // ─── Reports & Moderation ─────────────────────────────────────────────────

    match /reports/{reportId} {
      allow create: if isAuthenticated()
          && ( (request.resource.data.userId == request.auth.uid) || (request.resource.data.authorId == request.auth.uid) || (request.resource.data.reporterId == request.auth.uid) )
          && request.resource.data.targetId is string
          && request.resource.data.reason is string
          && (request.resource.data.reason.size() <= 2000);
      allow read, update, delete: if false;
    }

    match /bug_reports/{reportId} {
      // Submitted strictly via submitBugReportCallable Cloud Function for server-side rate limiting & abuse prevention
      allow create: if false;
      allow read, update, delete: if false;
    }

    match /moderation_reports/{reportId} {
      allow create: if isAuthenticated()
          && (request.resource.data.reporterId == request.auth.uid)
          && (request.resource.data.reason.size() <= 2000);
      allow read, update, delete: if false;
    }

    // Moderation events are server-managed internal logs; normal users CANNOT read or write directly
    match /moderationEvents/{eventId} {
      allow read, write: if false;
    }

    // Appeals: User can submit appeal for themselves and read ONLY their own appeal
    match /user_appeals/{appealId} {
      allow create: if isAuthenticated()
          && ( (request.resource.data.userId == request.auth.uid) || (request.resource.data.authorId == request.auth.uid) )
          && (request.resource.data.reason.size() <= 2000);
      allow read: if isAuthenticated()
          && ( (resource.data.userId == request.auth.uid) || (resource.data.authorId == request.auth.uid) );
      allow update, delete: if false;
    }

    // ─── Server Indices & Configs ─────────────────────────────────────────────

    match /hashtags/{hashtag} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /explore_bundles/{bundleId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /system_configs/{configId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // ─── Default Deny ─────────────────────────────────────────────────────────

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
