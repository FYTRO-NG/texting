rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Security Helper Functions ─────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner(authorField) {
      return isAuthenticated() && request.auth.uid == authorField;
    }

    function isValidFollow(data) {
      return data.followerId == request.auth.uid
          && data.followingId != request.auth.uid
          && data.keys().hasAll(["followerId", "followingId", "createdAt"]);
    }

    // Checks that protected user profile fields are not manipulated directly
    function notChangingProtectedUserFields() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(["reputationScore", "joinedAt", "uid"]);
    }

    // Checks that protected post fields are not manipulated on update
    function notChangingProtectedPostFields() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(["userId", "authorId", "createdAt", "viewCount"]);
    }

    // ─── Users ────────────────────────────────────────────────────────────────
    // Path: /users/{userId}

    match /users/{userId} {
      allow read: if isAuthenticated();

      allow create: if isOwner(userId)
          && request.resource.data.uid == userId
          && (!request.resource.data.keys().hasAny(["reputationScore", "followersCount", "followingCount", "postsCount"])
              || (request.resource.data.reputationScore == 100
                  && request.resource.data.followersCount == 0
                  && request.resource.data.followingCount == 0
                  && request.resource.data.postsCount == 0));

      allow update: if isOwner(userId)
          && request.resource.data.uid == userId
          && (!request.resource.data.keys().hasAny(["reputationScore"]) || request.resource.data.reputationScore == resource.data.reputationScore)
          && (!request.resource.data.keys().hasAny(["joinedAt"]) || request.resource.data.joinedAt == resource.data.joinedAt)
          || (isAuthenticated()
              && request.resource.data.diff(resource.data)
                  .affectedKeys()
                  .hasOnly(["followersCount", "followingCount", "postsCount"]));

      allow delete: if false;

      // Audit trail of username changes — viewable by owner, written only by Admin/Functions
      match /usernameHistory/{historyId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      // Per-user story view state cache — accessible only by doc owner
      match /storyViewState/{docId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ─── Usernames Index ─────────────────────────────────────────────────────
    // Path: /usernames/{usernameLower}
    // Public read for availability checks & profile URL resolution. Client writes disabled.

    match /usernames/{usernameLower} {
      allow read: if true;
      allow write: if false;
    }

    // ─── Posts ────────────────────────────────────────────────────────────────
    // Path: /posts/{postId}

    match /posts/{postId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
          && (request.resource.data.userId == request.auth.uid || request.resource.data.authorId == request.auth.uid)
          && request.resource.data.text.size() <= 2000
          && (!request.resource.data.keys().hasAny(["viewCount"]) || request.resource.data.viewCount == 0);

      allow update: if isAuthenticated()
          && ((resource.data.userId == request.auth.uid || resource.data.authorId == request.auth.uid) && notChangingProtectedPostFields()
              || request.resource.data.diff(resource.data)
                  .affectedKeys()
                  .hasOnly(["likes", "likedBy", "savedBy", "reposts", "commentsCount", "poll"]));

      allow delete: if isAuthenticated()
          && (resource.data.userId == request.auth.uid || resource.data.authorId == request.auth.uid);
    }

    // ─── Comments ─────────────────────────────────────────────────────────────
    // Path: /posts/{postId}/comments/{commentId}

    match /posts/{postId}/comments/{commentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
          && request.resource.data.text.size() <= 1000;
      allow delete: if isAuthenticated()
          && (resource.data.userId == request.auth.uid || resource.data.authorId == request.auth.uid);
    }

    // ─── Follows ─────────────────────────────────────────────────────────────
    // Path: /follows/{followId} ({followerId}_{followingId})

    match /follows/{followId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidFollow(request.resource.data);
      allow delete: if isAuthenticated() && resource.data.followerId == request.auth.uid;
      allow update: if false;
    }

    // ─── Anonymous Whispers ───────────────────────────────────────────────────
    // Path: /whispers/{whisperId}
    // Anonymous messages must NEVER expose the sender's private identity.

    match /whispers/{whisperId} {
      allow read: if isAuthenticated()
          && (resource.data.recipientId == request.auth.uid || resource.data.recipientUid == request.auth.uid);

      allow create: if isAuthenticated()
          && request.resource.data.isAnonymous == true
          && request.resource.data.text.size() <= 2000
          && !request.resource.data.keys().hasAny(["senderId", "senderUid", "authorId"]);

      allow update: if isAuthenticated()
          && (resource.data.recipientId == request.auth.uid || resource.data.recipientUid == request.auth.uid)
          && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly(["unread", "reactions"]);

      allow delete: if false;
    }

    // ─── Chats / Direct Messages ──────────────────────────────────────────────
    // Path: /chats/{chatId}

    match /chats/{chatId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.participants;
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.participants;
      allow update: if isAuthenticated() && request.auth.uid in resource.data.participants;

      match /messages/{msgId} {
        allow read: if isAuthenticated()
            && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if isAuthenticated()
            && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
            && request.resource.data.text.size() <= 1000;
      }
    }

    // ─── Communities ──────────────────────────────────────────────────────────
    // Path: /communities/{communityId}

    match /communities/{communityId} {
      allow read: if isAuthenticated() || resource.data.visibility == 'public';
      // Created only via createCommunity Cloud Function to enforce slug uniqueness
      allow create: if false;
      allow update: if isAuthenticated()
          && resource.data.ownerId == request.auth.uid
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["ownerId", "slug", "createdAt"]);
      allow delete: if false;

      match /members/{memberId} {
        allow read: if isAuthenticated();
        allow write: if false; // Managed via joinCommunity / leaveCommunity Cloud Functions
      }

      match /moderators/{modId} {
        allow read: if isAuthenticated();
        allow write: if false; // Managed via Cloud Functions
      }

      match /joinRequests/{reqId} {
        allow read: if isAuthenticated()
            && (reqId == request.auth.uid
                || get(/databases/$(database)/documents/communities/$(communityId)).data.ownerId == request.auth.uid);
        allow write: if false; // Managed via joinCommunity Cloud Function
      }
    }

    // ─── Stories ───────────────────────────────────────────────────────────────
    // Path: /stories/{storyId}

    match /stories/{storyId} {
      allow read: if isAuthenticated()
          && resource.data.expiresAt > request.time
          && resource.data.status == "active";

      // Created only via createStory Cloud Function to guarantee server-side timestamps & expiration
      allow create: if false;

      // Owner can only soft-delete (status = "deleted")
      allow update: if isAuthenticated()
          && resource.data.authorId == request.auth.uid
          && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly(["status"])
          && request.resource.data.status == "deleted";

      allow delete: if false;

      match /viewers/{viewerId} {
        allow read: if isAuthenticated()
            && (resource.data.userId == request.auth.uid
                || get(/databases/$(database)/documents/stories/$(storyId)).data.authorId == request.auth.uid);
        allow write: if false; // Recorded only via recordStoryView Cloud Function
      }
    }

    // ─── Notifications ────────────────────────────────────────────────────────
    // Path: /notifications/{notificationId}

    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.recipientId == request.auth.uid;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated()
          && resource.data.recipientId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["unread"]);
      allow delete: if isAuthenticated() && resource.data.recipientId == request.auth.uid;
    }

    // ─── Reports & Moderation ─────────────────────────────────────────────────

    match /reports/{reportId} {
      allow create: if isAuthenticated()
          && (request.resource.data.userId == request.auth.uid || request.resource.data.authorId == request.auth.uid);
      allow read, update, delete: if false;
    }

    match /bug_reports/{reportId} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    match /moderation_reports/{reportId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if false;
    }

    match /moderationEvents/{eventId} {
      allow create: if isAuthenticated();
      allow read, update: if isAuthenticated();
      allow delete: if false;
    }

    match /user_appeals/{appealId} {
      allow create: if isAuthenticated();
      allow read, update: if isAuthenticated();
      allow delete: if false;
    }

    // ─── Server Indices & Configs ─────────────────────────────────────────────

    match /hashtags/{hashtag} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /explore_bundles/{bundleId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /system_configs/{configId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // ─── Default Deny ─────────────────────────────────────────────────────────

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
