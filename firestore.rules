rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ─────────────────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidFollow(data) {
      // followerId must equal the calling user — prevents spoofed follows
      return data.followerId == request.auth.uid
          && data.followingId != request.auth.uid  // no self-follow
          && data.keys().hasAll(["followerId", "followingId", "createdAt"]);
    }

    // ─── Users ────────────────────────────────────────────────────────────────

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId)
          || (isAuthenticated()
              && request.resource.data.diff(resource.data)
                  .affectedKeys()
                  .hasOnly(["followersCount", "followingCount", "postsCount"]));
      allow delete: if false;

      // Username history audit trail — viewable by owner, written only by Admin/Functions
      match /usernameHistory/{historyId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
    }

    // ─── Usernames Index ─────────────────────────────────────────────────────
    // Uniqueness lookup index.
    // Public read so availability checks and profile URL resolution can query.
    // Client writes are disabled — all claims/changes MUST go through Cloud Functions.
    match /usernames/{usernameLower} {
      allow read: if true;
      allow write: if false;
    }


    // ─── Posts ────────────────────────────────────────────────────────────────

    match /posts/{postId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.text.size() <= 2000;
      allow update: if isAuthenticated()
          && (resource.data.userId == request.auth.uid
              || request.resource.data.diff(resource.data)
                  .affectedKeys()
                  .hasOnly(["likes", "likedBy", "savedBy", "reposts", "commentsCount", "poll"]));
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // ─── Comments ─────────────────────────────────────────────────────────────

    match /posts/{postId}/comments/{commentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
          && request.resource.data.text.size() <= 1000;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // ─── Follows ─────────────────────────────────────────────────────────────
    // Document ID pattern: {followerId}_{followingId} — enforces uniqueness

    match /follows/{followId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidFollow(request.resource.data);
      // Only the follower can delete their own follow relationship
      allow delete: if isAuthenticated() && resource.data.followerId == request.auth.uid;
      allow update: if false; // Follow relationships are immutable
    }

    // ─── Chats / Whispers ─────────────────────────────────────────────────────

    match /chats/{chatId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();

      match /messages/{msgId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated()
            && request.resource.data.text.size() <= 1000;
      }
    }

    // ─── Communities ──────────────────────────────────────────────────────────

    match /communities/{communityId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
    }

    // ─── Notifications ────────────────────────────────────────────────────────

    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.recipientId == request.auth.uid;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && resource.data.recipientId == request.auth.uid;
      allow delete: if false;
    }

    // ─── Reports ─────────────────────────────────────────────────────────────

    match /reports/{reportId} {
      allow create: if isAuthenticated()
          && request.resource.data.userId == request.auth.uid;
      // Users cannot read or modify reports after submission
      allow read, update, delete: if false;
    }

    match /bug_reports/{reportId} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    match /moderation_reports/{reportId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if false;
    }

    match /moderationEvents/{eventId} {
      allow create: if isAuthenticated();
      allow read, update: if isAuthenticated();
    }

    match /user_appeals/{appealId} {
      allow create: if isAuthenticated();
      allow read, update: if isAuthenticated();
    }

    // ─── Hashtags & Trending Index ──────────────────────────────────────────
    match /hashtags/{hashtag} {
      allow read: if isAuthenticated();
      allow write: if false; // Server-managed via Cloud Functions
    }

    // ─── Explore Recommendation Bundles ──────────────────────────────────────
    match /explore_bundles/{bundleId} {
      allow read: if isAuthenticated();
      allow write: if false; // Pre-computed and updated only by backend pipeline
    }

    // ─── System Configurations (Admin Tunable) ───────────────────────────────
    match /system_configs/{configId} {
      allow read: if isAuthenticated();
      allow write: if false; // Admin managed only
    }

    // ─── Default deny ─────────────────────────────────────────────────────────

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
