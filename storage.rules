rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function isAudio() {
      return request.resource.contentType.matches('audio/.*');
    }

    function isUnder10MB() {
      return request.resource.size < 10 * 1024 * 1024;
    }

    function isUnder15MB() {
      return request.resource.size < 15 * 1024 * 1024;
    }

    // ─── Profile photos ───────────────────────────────────────────────────────
    // Path: uploads/{userId}/profile.jpg

    match /uploads/{userId}/profile.jpg {
      allow read: if true;  // Public read — avatars must be visible to all
      allow write: if isOwner(userId) && isImage() && isUnder10MB();
    }

    // ─── Post images ──────────────────────────────────────────────────────────
    // Path: uploads/{userId}/posts/{filename}

    match /uploads/{userId}/posts/{filename} {
      allow read: if true;
      allow write: if isOwner(userId) && isImage() && isUnder10MB();
    }

    // ─── General uploads (legacy) ─────────────────────────────────────────────

    match /uploads/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(userId)
          && (isImage() || isAudio())
          && isUnder10MB();
    }

    // ─── Voice notes ──────────────────────────────────────────────────────────

    match /voicenotes/{userId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId)
          && isAudio()
          && isUnder15MB();
    }

    // ─── Story images ──────────────────────────────────────────────────────────
    // Path: stories/{userId}/{filename}

    match /stories/{userId}/{filename} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) && isImage() && isUnder10MB();
    }

    // ─── Default deny ─────────────────────────────────────────────────────────

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
